# vcpkg's own boost-fiber portfile, generated by scripts/boost/generate-ports.ps1,
# with try_lock's read of the owner moved under the spinlock, and a remote
# wake's notify before the remote ready queue's spinlock goes.

vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO boostorg/fiber
    REF boost-${VERSION}
    SHA512 04dddbe9890c41086f1de2fd7ef9b9a1018b633804d395da1b15191883b4be8cc7b5919df5debc94111c6a0242ef5d40ac53f5615e4410ca99d56fd9fdb6e73e
    HEAD_REF master
    PATCHES
        try-lock-owner-race.patch
        remote-wake-notify.patch
        tsan-mutex-annotations.patch
)

set(FEATURE_OPTIONS "")
boost_configure_and_install(
    SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS ${FEATURE_OPTIONS}
)
