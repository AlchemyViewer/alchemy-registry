+#include <atomic>
 #include <optional>
 #include <string>
 
@@ -114,7 +115,8 @@ struct Error
     std::optional<Id> synthetic;
 
 private:
-    static int nextIndex;
+    // Errors are made on every thread that checks a module.
+    static std::atomic<int> nextIndex;
 };
 
