 endif()
 
 # make .natvis visible inside the solution
-if(MSVC_IDE)
+if(MSVC_IDE AND NOT LUAU_INSTALL_ANALYSIS)
     target_sources(Luau.Ast PRIVATE tools/natvis/Ast.natvis)
     target_sources(Luau.Analysis PRIVATE tools/natvis/Analysis.natvis)
     target_sources(Luau.CodeGen PRIVATE tools/natvis/CodeGen.natvis)
@@ -429,3 +434,39 @@ foreach(LIB Luau.Ast Luau.Compiler Luau.Config Luau.Analysis Luau.CodeGen Luau.V
         endif()
     endif()
 endforeach()
+
+# The offline components as a package: what a tool that parses, checks and
+# compiles scripts links, and nothing that runs them. CodeGen, the inliner,
+# the executor, the REPL support and isocline are left out of the default
+# build as well as out of the package.
+if(LUAU_INSTALL_ANALYSIS)
+    include(GNUInstallDirs)
+
+    set_target_properties(Luau.CodeGen Luau.Inliner Luau.Executor Luau.Require Luau.CLI.lib isocline PROPERTIES EXCLUDE_FROM_ALL ON)
+
+    install(
+        TARGETS Luau.Common Luau.LSLBuiltins Luau.Ast Luau.Bytecode Luau.Compiler Luau.Config Luau.Analysis Luau.VM
+        EXPORT unofficial-slua-targets
+        ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+        LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+        RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
+    )
+
+    foreach(component Common LSLBuiltins Ast Bytecode Compiler Config Analysis VM)
+        install(
+            DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${component}/include/"
+            DESTINATION "include/slua"
+            FILES_MATCHING PATTERN "*.h"
+        )
+    endforeach()
+
+    install(
+        EXPORT unofficial-slua-targets
+        NAMESPACE unofficial::slua::
+        DESTINATION "${CMAKE_INSTALL_DATADIR}/unofficial-slua"
+    )
+    install(
+        FILES "${CMAKE_CURRENT_SOURCE_DIR}/cmake/unofficial-slua-config.cmake"
+        DESTINATION "${CMAKE_INSTALL_DATADIR}/unofficial-slua"
+    )
+endif()
