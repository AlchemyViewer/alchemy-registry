+// strtoul as the grid's 32-bit Linux hosts have it, where the VMs cast a
+// string to an integer: leading spaces, a sign, digits of the base, and past
+// 0xFFFFFFFF it stops there -- -1 once signed, its minus or not -- where a
+// 64-bit host's strtoul would wrap it ("4294967296" was 0).
+static S32 strtoul32(const char *text, int base) {
+  const char *at = text;
+  while (*at == ' ' || (*at >= '\t' && *at <= '\r'))
+    ++at;
+  const bool negative = *at == '-';
+  if (*at == '+' || *at == '-')
+    ++at;
+  if (base == 16 && at[0] == '0' && (at[1] == 'x' || at[1] == 'X') && isxdigit((unsigned char)at[2]))
+    at += 2;
+  unsigned long long value = 0;
+  bool past = false;
+  for (;; ++at) {
+    int digit;
+    if (*at >= '0' && *at <= '9')
+      digit = *at - '0';
+    else if (base == 16 && isxdigit((unsigned char)*at))
+      digit = tolower((unsigned char)*at) - 'a' + 10;
+    else
+      break;
+    value = value * (unsigned long long)base + (unsigned long long)digit;
+    if (value > 0xFFFFFFFFull) {
+      past = true;
+      value = 0xFFFFFFFFull;
+    }
+  }
+  if (past)
+    return -1;
+  return (S32)(negative ? 0u - (unsigned int)value : (unsigned int)value);
+}
