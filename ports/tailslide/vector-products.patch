 namespace Tailslide {
 
+// A single's product, sum or difference as the VM makes it: rounded on its
+// own. Written out as `a * b + c * d` a compiler may fuse a product into the
+// sum after it and round once where the VM rounds twice -- so that a vector
+// crossed with itself is not zero. Each is worked out in double, exact for a
+// product of two singles and near enough for a sum that rounding it to a
+// single gives the single's own answer, and is then rounded to a single.
+static float singleMul(float a, float b) { return (float)((double)a * (double)b); }
+static float singleAdd(float a, float b) { return (float)((double)a + (double)b); }
+static float singleSub(float a, float b) { return (float)((double)a - (double)b); }
