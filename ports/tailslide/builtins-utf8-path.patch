+// The path is UTF-8. On Windows the narrow fopen() reads it in the ANSI code
+// page instead, which misses a file under any directory named with a
+// character outside that page, so it goes through UTF-16 and _wfopen().
+static FILE *open_builtins_file(const char *builtins_file) {
+#ifdef _WIN32
+  const int wide_len = MultiByteToWideChar(CP_UTF8, 0, builtins_file, -1, nullptr, 0);
+  if (wide_len <= 0)
+    return nullptr;
+  std::wstring wide(static_cast<size_t>(wide_len), L'\0');
+  if (MultiByteToWideChar(CP_UTF8, 0, builtins_file, -1, wide.data(), wide_len) != wide_len)
+    return nullptr;
+  return _wfopen(wide.c_str(), L"r");
+#else
+  return fopen(builtins_file, "r");
+#endif
+}
