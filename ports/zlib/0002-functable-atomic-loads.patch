diff --git a/functable.h b/functable.h
index 91308e5..46d5aea 100644
--- a/functable.h
+++ b/functable.h
@@ -43,11 +43,23 @@ struct functable_s {
 Z_INTERNAL extern struct functable_s functable;
 
 
+/* Each entry is read with an atomic load, as init_functable writes it with
+ * an atomic store: the first call through the table on any thread fills it
+ * while other threads may be calling through it. Every value an entry holds
+ * is a function that can be called, a stub or the one chosen, so relaxed is
+ * enough; a plain load beside the store is still a data race.
+ */
+#  if defined(__GNUC__) || defined(__clang__)
+#    define FUNCTABLE_LOAD(name) __atomic_load_n(&functable.name, __ATOMIC_RELAXED)
+#  else
+#    define FUNCTABLE_LOAD(name) functable.name
+#  endif
+
 /* Explicitly indicate functions are conditionally dispatched.
  */
-#  define FUNCTABLE_INIT if (functable.force_init()) {return Z_VERSION_ERROR;}
-#  define FUNCTABLE_CALL(name) functable.name
-#  define FUNCTABLE_FPTR(name) functable.name
+#  define FUNCTABLE_INIT if (FUNCTABLE_LOAD(force_init)()) {return Z_VERSION_ERROR;}
+#  define FUNCTABLE_CALL(name) FUNCTABLE_LOAD(name)
+#  define FUNCTABLE_FPTR(name) FUNCTABLE_LOAD(name)
 
 #endif
 
