 	FAudioEngineCallback *callback;
@@ -1647,13 +1658,18 @@ static void FAUDIOCALL FAudio_INTERNAL_GenerateOutput(FAudio *audio, float *outp
 	FAudio_PlatformUnlockMutex(audio->submixLock);
 	LOG_MUTEX_UNLOCK(audio, audio->submixLock)
 
-	/* Apply master volume */
-	if (audio->master->volume != 1.0f)
+	/* Apply master volume, which SetVolume writes under volumeLock */
+	FAudio_PlatformLockMutex(audio->master->volumeLock);
+	LOG_MUTEX_LOCK(audio, audio->master->volumeLock)
+	masterVolume = audio->master->volume;
+	FAudio_PlatformUnlockMutex(audio->master->volumeLock);
+	LOG_MUTEX_UNLOCK(audio, audio->master->volumeLock)
+	if (masterVolume != 1.0f)
 	{
 		FAudio_INTERNAL_Amplify(
 			audio->master->master.output,
 			audio->updateSize * audio->master->master.inputChannels,
-			audio->master->volume
+			masterVolume
 		);
 	}
 
