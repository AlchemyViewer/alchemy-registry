+	// corners past the last whole triangle have no flags
+	for (size_t i = 0; i < face_count * 3; ++i)
+	{
+		if (flags[i / 3] & Face_Degenerate)
+			continue;
+
+		float* r = &result[i * 4];
+
+		if (groups[i] == ~0u)
+		{
+			r[0] = fallback, r[1] = 0.f, r[2] = 0.f, r[3] = -1.f;
+			continue;
+		}
