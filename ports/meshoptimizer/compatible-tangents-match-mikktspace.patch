+enum
+{
+	// two corners share a position; such triangles are left out of adjacency and take their tangents from other triangles
+	Face_Degenerate = 1 << 0,
+	// UV area and both derivative magnitudes are above FLT_MIN; only these triangles contribute to tangent sums
+	Face_Good = 1 << 1,
+	// UV area is positive; triangles that are not good take the orientation of the first group that reaches them
+	Face_Orient = 1 << 2,
+};
+
+// per-corner data for compatible mode: projected tangent (0-2), projected bitangent (3-5), angle between projected edges (6)
+const size_t kCornerData = 7;
+
+// normalizes the vector unless all of its components are within FLT_MIN of zero, in which case it is left as is
+static void normalizeNotZero(float* v)
+{
+	if (fabsf(v[0]) > FLT_MIN || fabsf(v[1]) > FLT_MIN || fabsf(v[2]) > FLT_MIN)
+	{
+		float s = 1.f / sqrtf(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+
+		v[0] *= s;
+		v[1] *= s;
+		v[2] *= s;
+	}
+}
+
+// computes normalized tangent (xyz) and bitangent (xyz) per triangle, using the same operations and thresholds as the MikkTSpace reference
+static void computeFaceTangentsCompatible(float* result, unsigned char* flags, size_t triangle_count, const unsigned int* indices, const float* vertex_positions, size_t vertex_positions_stride, const float* vertex_uvs, size_t vertex_uvs_stride)
+{
+	size_t vertex_position_stride_float = vertex_positions_stride / sizeof(float);
+	size_t vertex_uv_stride_float = vertex_uvs_stride / sizeof(float);
+
+	for (size_t i = 0; i < triangle_count; ++i)
+	{
+		unsigned int a = indices ? indices[i * 3 + 0] : unsigned(i * 3 + 0);
+		unsigned int b = indices ? indices[i * 3 + 1] : unsigned(i * 3 + 1);
+		unsigned int c = indices ? indices[i * 3 + 2] : unsigned(i * 3 + 2);
+
+		const float* pa = &vertex_positions[a * vertex_position_stride_float];
+		const float* pb = &vertex_positions[b * vertex_position_stride_float];
+		const float* pc = &vertex_positions[c * vertex_position_stride_float];
+
+		const float* ta = &vertex_uvs[a * vertex_uv_stride_float];
+		const float* tb = &vertex_uvs[b * vertex_uv_stride_float];
+		const float* tc = &vertex_uvs[c * vertex_uv_stride_float];
+
+		bool degenerate = (pa[0] == pb[0] && pa[1] == pb[1] && pa[2] == pb[2]) || (pa[0] == pc[0] && pa[1] == pc[1] && pa[2] == pc[2]) || (pb[0] == pc[0] && pb[1] == pc[1] && pb[2] == pc[2]);
+
+		float dp1x = pb[0] - pa[0], dp1y = pb[1] - pa[1], dp1z = pb[2] - pa[2];
+		float dp2x = pc[0] - pa[0], dp2y = pc[1] - pa[1], dp2z = pc[2] - pa[2];
+		float dt1x = tb[0] - ta[0], dt1y = tb[1] - ta[1];
+		float dt2x = tc[0] - ta[0], dt2y = tc[1] - ta[1];
+
+		float det = dt1x * dt2y - dt1y * dt2x;
+
+		// tangent and bitangent using chain rule, see eq. 42; the operations are ordered as in the reference so that the results match bit for bit
+		float sx = dt2y * dp1x - dt1y * dp2x, sy = dt2y * dp1y - dt1y * dp2y, sz = dt2y * dp1z - dt1y * dp2z;
+		float tx = -dt2x * dp1x + dt1x * dp2x, ty = -dt2x * dp1y + dt1x * dp2y, tz = -dt2x * dp1z + dt1x * dp2z;
+
+		float* r = &result[i * 6];
+		memset(r, 0, sizeof(float) * 6);
+
+		unsigned char flag = (degenerate ? Face_Degenerate : 0) | (det > 0.f ? Face_Orient : 0);
+
+		if (!degenerate && fabsf(det) > FLT_MIN)
+		{
+			float area = fabsf(det);
+			float sign = det > 0.f ? 1.f : -1.f;
+
+			float sl = sqrtf(sx * sx + sy * sy + sz * sz);
+			float tl = sqrtf(tx * tx + ty * ty + tz * tz);
+
+			if (sl > FLT_MIN)
+			{
+				float ss = sign / sl;
+				r[0] = ss * sx, r[1] = ss * sy, r[2] = ss * sz;
+			}
+
+			if (tl > FLT_MIN)
+			{
+				float ts = sign / tl;
+				r[3] = ts * tx, r[4] = ts * ty, r[5] = ts * tz;
+			}
+
+			flag |= (sl / area > FLT_MIN && tl / area > FLT_MIN) ? Face_Good : 0;
+		}
+
+		flags[i] = flag;
+	}
+}
