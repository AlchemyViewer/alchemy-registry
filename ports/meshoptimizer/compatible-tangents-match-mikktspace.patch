+		near = near && r[0] * r[0] + r[1] * r[1] + r[2] * r[2] < 1.0001f && r[3] * r[3] + r[4] * r[4] + r[5] * r[5] < 1.0001f;
+
+		local[good * 3 + 0] = corner;
+		local[good * 3 + 1] = groups[corner];
+		local[good * 3 + 2] = near ? 0 : 2;
+		good++;
+		far += !near;
+	}
+
+	if (!far)
+		return split_count;
+
+	// number the groups around this vertex; buckets maps a root to its group's number, and roots belong to one vertex, so it is never cleared
+	size_t group_count = 0;
+
+	for (size_t i = 0; i < good; ++i)
+	{
+		unsigned int& bucket = buckets[local[i * 3 + 1]];
+
+		if (bucket == ~0u)
+			bucket = unsigned(group_count++);
+
+		local[i * 3 + 1] = bucket;
+	}
+
+	// list each group's corners together, in list order; starts[g] counts group g's corners, then sums them to its end, and steps back to its start
+	// as they are placed from the last
+	unsigned int* order = local + count * 3;
+	unsigned int* starts = local + count * 4;
+
+	memset(starts, 0, group_count * sizeof(unsigned int));
+
+	for (size_t i = 0; i < good; ++i)
+		starts[local[i * 3 + 1]]++;
+
+	for (size_t g = 1; g < group_count; ++g)
+		starts[g] += starts[g - 1];
+
+	for (size_t i = good; i > 0; --i)
+		order[--starts[local[(i - 1) * 3 + 1]]] = unsigned(i - 1);
+
+	for (size_t g = 0; g < group_count; ++g)
+	{
+		size_t begin = starts[g], end = g + 1 < group_count ? starts[g + 1] : good;
+		size_t size = end - begin;
+
+		size_t group_far = 0;
+
+		for (size_t k = begin; k < end; ++k)
+			group_far += (local[order[k] * 3 + 2] & 2) != 0;
+
+		if (group_far == 0 || size < 2)
+			continue;
+
+		// pair tests (far corners by the group) and sum tests (split corners by the group) past this split the group approximately
+		size_t budget = size * 64 + 1024;
+
+		if (group_far > budget / (size - 1))
+		{
+			split_count = splitTangentGroupApproximately(split, split_count, corner_data, local, &order[begin], size, cells, vectors, sums);
+			continue;
+		}
+
+		// compare each corner that is far from its root with the rest of its group
+		size_t marked = 0;
+
+		for (size_t k = begin; k < end; ++k)
+		{
+			unsigned int i = order[k];
+
+			if ((local[i * 3 + 2] & 2) == 0)
+				continue;
+
+			const float* si = &corner_data[local[i * 3] * kCornerData];
+
+			for (size_t l = begin; l < end; ++l)
+			{
+				unsigned int j = order[l];
+
+				if (j == i)
+					continue;
+
+				const float* sj = &corner_data[local[j * 3] * kCornerData];
+
+				float coss = si[0] * sj[0] + si[1] * sj[1] + si[2] * sj[2];
+				float cost = si[3] * sj[3] + si[4] * sj[4] + si[5] * sj[5];
+
+				if (!(coss > threshold && cost > threshold))
+				{
+					marked += (local[i * 3 + 2] & 1) == 0;
+					local[i * 3 + 2] |= 1;
+					marked += (local[j * 3 + 2] & 1) == 0;
+					local[j * 3 + 2] |= 1;
+				}
+			}
+		}
+
+		if (marked == 0)
+			continue;
+
+		if (marked > budget / size)
+		{
+			split_count = splitTangentGroupApproximately(split, split_count, corner_data, local, &order[begin], size, cells, vectors, sums);
+			continue;
+		}
+
+		for (size_t k = begin; k < end; ++k)
+		{
+			unsigned int i = order[k];
+
+			if ((local[i * 3 + 2] & 1) == 0)
+				continue;
+
+			const float* si = &corner_data[local[i * 3] * kCornerData];
+			float* r = &sums[i * 3];
+
+			r[0] = r[1] = r[2] = 0.f;
+
+			for (size_t l = begin; l < end; ++l)
+			{
+				unsigned int j = order[l];
+				const float* sj = &corner_data[local[j * 3] * kCornerData];
+
+				float coss = si[0] * sj[0] + si[1] * sj[1] + si[2] * sj[2];
+				float cost = si[3] * sj[3] + si[4] * sj[4] + si[5] * sj[5];
+
+				if (i == j || (coss > threshold && cost > threshold))
+				{
+					r[0] += sj[6] * sj[0];
+					r[1] += sj[6] * sj[1];
+					r[2] += sj[6] * sj[2];
+				}
+			}
+
+			normalizeNotZero(r);
+		}
+
+		// the projected tangents of this group are only read above, so they can take the sums now
+		for (size_t k = begin; k < end; ++k)
+		{
+			unsigned int i = order[k];
+
+			if (local[i * 3 + 2] & 1)
+			{
+				memcpy(&corner_data[local[i * 3] * kCornerData], &sums[i * 3], sizeof(float) * 3);
+				split[split_count++] = local[i * 3];
+			}
+		}
+	}
+
+	return split_count;
+}
