+// splits a group too large to split exactly, members listing its corners in list order: each split corner takes the group's sum without the corners
+// whose vectors are not a number, which are opposite to every corner, less its own exactly opposite partners; this is the reference's result to
+// rounding, and exactly it for a corner whose only partners are those. Vectors whose squared lengths are within 0.999 and 1 + 2^-19 can only be
+// exactly opposite within 1/256 of each other's opposite, as the square of their sum's length is under 2 * 2^-19 plus the dot product's rounding, so
+// such partners are found by cells, the tangents' and the bitangents' apart; vectors shorter than that are opposite to none of them, and corners with
+// a vector that is neither are compared with every corner. A group whose cells hold more candidates than a budget linear in its size, which takes a
+// pole of thousands of triangles or a mesh made to crowd near-opposite tangents together, is left whole, its corners all taking the group's tangent
+static size_t splitTangentGroupApproximately(unsigned int* split, size_t split_count, float* corner_data, unsigned int* local, const unsigned int* members, size_t size, unsigned int* cells, float* vectors, float* sums)
+{
+	enum
+	{
+		Class_NaN = 1 << 0,     // a component of either vector is not a number
+		Class_Other = 1 << 1,   // otherwise, a vector is neither in the cells nor shorter than them
+		Class_Tangent = 1 << 2, // the tangent is in the cells
+		Class_Bitangent = 1 << 3,
+	};
+
+	unsigned int* classes = cells;
+	unsigned int* tangent_keys = cells + size;
+	unsigned int* bitangent_keys = cells + size * 2;
+	unsigned int* tangents = cells + size * 3;
+	unsigned int* bitangents = cells + size * 4;
+	unsigned int* scratch = cells + size * 5;
+	unsigned int* stamp = cells + size * 6;
+
+	size_t nans = 0, tangent_count = 0, bitangent_count = 0;
+	float base[3] = {0.f, 0.f, 0.f};
+
+	for (size_t p = 0; p < size; ++p)
+	{
+		const float* s = &corner_data[local[members[p] * 3] * kCornerData];
+
+		unsigned int c = 0;
+
+		for (int k = 0; k < 6; ++k)
+			c |= (s[k] != s[k]) ? Class_NaN : 0;
+
+		for (int v = 0; v < 2 && !(c & Class_NaN); ++v)
+		{
+			const float* d = s + v * 3;
+			float l = d[0] * d[0] + d[1] * d[1] + d[2] * d[2];
+
+			if (l > 0.999f && l < 1.0000019f)
+				c |= v ? Class_Bitangent : Class_Tangent;
+			else if (!(l <= 0.999f))
+				c |= Class_Other;
+		}
+
+		// a corner compared with every other is in no cells
+		if (c & Class_Other)
+			c &= ~(Class_Tangent | Class_Bitangent);
+
+		classes[p] = c;
+		stamp[p] = ~0u;
+		nans += (c & Class_NaN) != 0;
+
+		float* d = &vectors[p * 9];
+
+		for (int k = 0; k < 6; ++k)
+			d[k] = s[k];
+
+		d[6] = s[6] * s[0], d[7] = s[6] * s[1], d[8] = s[6] * s[2];
+
+		tangent_keys[p] = (c & Class_Tangent) ? cellKey(cellIndex(s[0]), cellIndex(s[1]), cellIndex(s[2])) : 0;
+		bitangent_keys[p] = (c & Class_Bitangent) ? cellKey(cellIndex(s[3]), cellIndex(s[4]), cellIndex(s[5])) : 0;
+
+		if (c & Class_Tangent)
+			tangents[tangent_count++] = unsigned(p);
+
+		if (c & Class_Bitangent)
+			bitangents[bitangent_count++] = unsigned(p);
+
+		// the group's sum in list order without the corners that are not a number
+		if ((c & Class_NaN) == 0)
+		{
+			base[0] += s[6] * s[0];
+			base[1] += s[6] * s[1];
+			base[2] += s[6] * s[2];
+		}
+	}
+
+	// a small group compares every pair, which costs less than its cells would
+	bool direct = size <= 128;
+
+	if (!direct)
+	{
+		// the members in cells by key, each list's keys then put in its order
+		KeyLess tangent_less = {tangent_keys};
+		sortStable(tangents, scratch, tangent_count, tangent_less);
+
+		for (size_t k = 0; k < tangent_count; ++k)
+			scratch[k] = tangent_keys[tangents[k]];
+
+		memcpy(tangent_keys, scratch, tangent_count * sizeof(unsigned int));
+
+		KeyLess bitangent_less = {bitangent_keys};
+		sortStable(bitangents, scratch, bitangent_count, bitangent_less);
+
+		for (size_t k = 0; k < bitangent_count; ++k)
+			scratch[k] = bitangent_keys[bitangents[k]];
+
+		memcpy(bitangent_keys, scratch, bitangent_count * sizeof(unsigned int));
+	}
+
+	// the sorts are done with scratch, which now lists the corners compared with every other
+	unsigned int* other_list = scratch;
+	size_t other_count = 0;
+
+	for (size_t p = 0; p < size; ++p)
+		if ((classes[p] & (Class_NaN | Class_Other)) == Class_Other)
+			other_list[other_count++] = unsigned(p);
+
+	size_t budget = size * 64 + 1024, visits = 0;
+
+	for (size_t p = 0; p < size; ++p)
+	{
+		const float* s = &corner_data[local[members[p] * 3] * kCornerData];
+		float* r = &sums[members[p] * 3];
+		unsigned int c = classes[p];
+
+		local[members[p] * 3 + 2] &= ~1u;
+
+		if (c & Class_NaN)
+		{
+			// opposite to every other corner, so its own sum is all it keeps
+			r[0] = r[1] = r[2] = 0.f;
+			r[0] += s[6] * s[0];
+			r[1] += s[6] * s[1];
+			r[2] += s[6] * s[2];
+			local[members[p] * 3 + 2] |= 1;
+			continue;
+		}
+
+		r[0] = base[0], r[1] = base[1], r[2] = base[2];
+
+		OppositeVisit visit = {vectors, stamp, unsigned(p), -1, r, 0, 0};
+
+		if (direct || (c & Class_Other))
+		{
+			for (size_t q = 0; q < size; ++q)
+				if ((classes[q] & Class_NaN) == 0)
+					visit(unsigned(q));
+		}
+		else
+		{
+			for (size_t k = 0; k < other_count; ++k)
+				visit(other_list[k]);
+
+			visit.component = 0;
+
+			if (c & Class_Tangent)
+				visitOpposite(s, tangents, tangent_count, tangent_keys, visit);
+
+			visit.component = 3;
+
+			if (c & Class_Bitangent)
+				visitOpposite(s + 3, bitangents, bitangent_count, bitangent_keys, visit);
+		}
+
+		visits += visit.visits;
+
+		if (!direct && visits > budget)
+		{
+			for (size_t k = 0; k < size; ++k)
+				local[members[k] * 3 + 2] &= ~1u;
+
+			return split_count;
+		}
+
+		if (visit.partners || nans)
+			local[members[p] * 3 + 2] |= 1;
+	}
+
+	for (size_t p = 0; p < size; ++p)
+	{
+		unsigned int i = members[p];
+
+		if (local[i * 3 + 2] & 1)
+		{
+			normalizeNotZero(&sums[i * 3]);
+			memcpy(&corner_data[local[i * 3] * kCornerData], &sums[i * 3], sizeof(float) * 3);
+			split[split_count++] = local[i * 3];
+		}
+	}
+
+	return split_count;
+}
+
+// the reference leaves out of a good triangle's sum the good triangles of its group whose projected tangent or bitangent is exactly opposite to its own;
+// for such triangles around vertex v, sums the rest of their group in triangle order into their projected tangent, normalized, and lists their corners
+// each split sum keeps its own order, so a group with many of them costs its size squared, as at a pole whose UVs pinch to a point, where nearly every
+// corner has an opposite; a group whose pairs or sums would cost more than a budget linear in its size is split by splitTangentGroupApproximately
+static size_t splitTangentGroupsCompatible(unsigned int* split, size_t split_count, float* corner_data, unsigned int* local, unsigned int* buckets, unsigned int* cells, float* vectors, float* sums, const unsigned int* groups, const unsigned char* flags, const unsigned int* data, size_t count)
+{
