+static void tangentCompatibleHub()
+{
+	struct Vertex
+	{
+		float px, py, pz;
+		float nx, ny, nz;
+		float tx, ty;
+	};
+
+	// one vertex shared by 20000 triangles, as disjoint triangles around it (a star) and as a closed fan, in order and shuffled; the fan winds
+	// round the vertex 2731 times, so its triangles are not slivers, and rim UVs wobble a little, so the triangles' tangents differ
+	const size_t count = 20000;
+	const size_t step = 2731;
+
+	std::vector<Vertex> star_vertices(1 + count * 2), fan_vertices(1 + count);
+
+	for (int mesh = 0; mesh < 2; ++mesh)
+	{
+		std::vector<Vertex>& vertices = mesh == 0 ? star_vertices : fan_vertices;
+
+		const Vertex hub = {0, 0, 0, 0, 0, 1, 0.5f, 0.5f};
+		vertices[0] = hub;
+
+		for (size_t i = 1; i < vertices.size(); ++i)
+		{
+			// the star's triangles span the same angles as the fan's, between points of the fan's rim
+			size_t k = mesh == 0 ? i / 2 : i - 1;
+			float a = 6.2831853f * float((k * step) % count) / float(count);
+
+			Vertex& v = vertices[i];
+			v.px = cosf(a), v.py = sinf(a), v.pz = 0.f;
+			v.nx = 0.f, v.ny = 0.f, v.nz = 1.f;
+			v.tx = v.px * 0.5f + 0.5f;
+			v.ty = v.py * 0.5f + 0.5f + 0.01f * sinf(float(i) * 7.f);
+		}
+	}
+
+	std::vector<unsigned int> star(count * 3), fan(count * 3), shuffled(count * 3);
+
+	for (size_t i = 0; i < count; ++i)
+	{
+		star[i * 3 + 0] = 0, star[i * 3 + 1] = unsigned(1 + i * 2), star[i * 3 + 2] = unsigned(2 + i * 2);
+		fan[i * 3 + 0] = 0, fan[i * 3 + 1] = unsigned(1 + i), fan[i * 3 + 2] = unsigned(1 + (i + 1) % count);
+	}
+
+	// the fan in another order, each triangle starting at another corner
+	std::vector<unsigned int> order(count);
+
+	for (size_t i = 0; i < count; ++i)
+		order[i] = unsigned(i);
+
+	unsigned int seed = 42;
+
+	for (size_t i = count - 1; i > 0; --i)
+	{
+		seed = seed * 1664525 + 1013904223;
+		size_t j = (seed >> 8) % (i + 1);
+
+		unsigned int t = order[i];
+		order[i] = order[j];
+		order[j] = t;
+	}
+
+	for (size_t i = 0; i < count; ++i)
+		for (size_t k = 0; k < 3; ++k)
+			shuffled[i * 3 + k] = fan[order[i] * 3 + (k + order[i]) % 3];
+
+	std::vector<float> star_tangents(count * 3 * 4), fan_tangents(count * 3 * 4), shuffled_tangents(count * 3 * 4);
+	meshopt_generateTangents(&star_tangents[0], &star[0], count * 3, &star_vertices[0].px, star_vertices.size(), sizeof(Vertex), &star_vertices[0].nx, sizeof(Vertex), &star_vertices[0].tx, sizeof(Vertex), meshopt_TangentCompatible);
+	meshopt_generateTangents(&fan_tangents[0], &fan[0], count * 3, &fan_vertices[0].px, fan_vertices.size(), sizeof(Vertex), &fan_vertices[0].nx, sizeof(Vertex), &fan_vertices[0].tx, sizeof(Vertex), meshopt_TangentCompatible);
+	meshopt_generateTangents(&shuffled_tangents[0], &shuffled[0], count * 3, &fan_vertices[0].px, fan_vertices.size(), sizeof(Vertex), &fan_vertices[0].nx, sizeof(Vertex), &fan_vertices[0].tx, sizeof(Vertex), meshopt_TangentCompatible);
+
+	// in the star, no edges are shared, so the hub keeps each triangle's own tangent, which differ
+	bool differ = false;
+
+	for (size_t i = 0; i < count; ++i)
+	{
+		const float* t = &star_tangents[i * 12];
+
+		for (size_t k = 0; k < 4; ++k)
+		{
+			assert(fabsf(t[k] - t[4 + k]) < 1e-5f && fabsf(t[k] - t[8 + k]) < 1e-5f);
+			differ |= fabsf(t[k] - star_tangents[k]) > 1e-3f;
+		}
+
+		assert(fabsf(t[0] - 1.f) < 0.1f && t[3] == 1.f);
+	}
+
+	assert(differ);
+
+	// in the fan, the hub has one tangent
+	for (size_t i = 0; i < count; ++i)
+		for (size_t k = 0; k < 4; ++k)
+			assert(fan_tangents[i * 12 + k] == fan_tangents[k]);
+
+	assert(fabsf(fan_tangents[0] - 1.f) < 1e-3f && fan_tangents[3] == 1.f);
+
+	// shuffled, every corner matches the fan's; the hub sums in another order
+	for (size_t i = 0; i < count; ++i)
+		for (size_t k = 0; k < 3; ++k)
+			for (size_t c = 0; c < 4; ++c)
+				assert(fabsf(shuffled_tangents[(i * 3 + k) * 4 + c] - fan_tangents[(order[i] * 3 + (k + order[i]) % 3) * 4 + c]) < 1e-5f);
+
+	// a fan whose UVs pinch to a point at the hub, so its tangents turn all the way round it and most hub corners are exactly opposite to another;
+	// splitting them would sum the group once for each, so the group is left whole and every hub corner takes its tangent
+	std::vector<Vertex> pinched_vertices(1 + count);
+
+	const Vertex pole = {0, 0, 0, 0, 0, 1, 0.5f, 0.f};
+	pinched_vertices[0] = pole;
+
+	for (size_t i = 1; i <= count; ++i)
+	{
+		float a = 6.2831853f * float(i - 1) / float(count);
+
+		Vertex& v = pinched_vertices[i];
+		v.px = cosf(a), v.py = sinf(a), v.pz = 0.f;
+		v.nx = 0.f, v.ny = 0.f, v.nz = 1.f;
+		v.tx = float(i - 1) / float(count), v.ty = 1.f;
+	}
+
+	std::vector<unsigned int> pinched((count - 1) * 3);
+
+	for (size_t i = 0; i < count - 1; ++i)
+		pinched[i * 3 + 0] = 0, pinched[i * 3 + 1] = unsigned(1 + i), pinched[i * 3 + 2] = unsigned(2 + i);
+
+	std::vector<float> pinched_tangents((count - 1) * 3 * 4);
+	meshopt_generateTangents(&pinched_tangents[0], &pinched[0], pinched.size(), &pinched_vertices[0].px, pinched_vertices.size(), sizeof(Vertex), &pinched_vertices[0].nx, sizeof(Vertex), &pinched_vertices[0].tx, sizeof(Vertex), meshopt_TangentCompatible);
+
+	for (size_t i = 0; i < count - 1; ++i)
+		for (size_t k = 0; k < 4; ++k)
+			assert(pinched_tangents[i * 12 + k] == pinched_tangents[k]);
+}
