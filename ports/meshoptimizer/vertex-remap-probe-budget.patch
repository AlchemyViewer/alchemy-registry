+// numbers vertices as generateVertexRemap does, with equal vertices made adjacent by sorting in place of the table: each run of equal vertices takes
+// the next number when an index first names one of them, and vertices no index names keep ~0u
+template <typename Hash>
+static size_t generateVertexRemapSorted(unsigned int* remap, const unsigned int* indices, size_t index_count, size_t vertex_count, const Hash& hash, meshopt_Allocator& allocator)
+{
+	unsigned int* order = allocator.allocate<unsigned int>(vertex_count);
+	unsigned int* first = allocator.allocate<unsigned int>(vertex_count);
+
+	for (size_t i = 0; i < vertex_count; ++i)
+		order[i] = unsigned(i);
+
+	sortVertices(order, first, vertex_count, hash);
+
+	// first[v] is the vertex that leads the run of vertices equal to v
+	for (size_t i = 0, run = 0; i < vertex_count; ++i)
+	{
+		if (!hash.equal(order[run], order[i]))
+			run = i;
+
+		first[order[i]] = order[run];
+	}
+
+	// order is reused for each run's number, kept at the vertex that leads it
+	memset(remap, -1, vertex_count * sizeof(unsigned int));
+	memset(order, -1, vertex_count * sizeof(unsigned int));
+
+	unsigned int next_vertex = 0;
+
+	for (size_t i = 0; i < index_count; ++i)
+	{
+		unsigned int index = indices ? indices[i] : unsigned(i);
+		assert(index < vertex_count);
+
+		unsigned int& number = order[first[index]];
+
+		if (number == ~0u)
+			number = next_vertex++;
+
+		remap[index] = number;
+	}
+
+	allocator.deallocate(first);
+	allocator.deallocate(order);
+
+	assert(next_vertex <= vertex_count);
+	return next_vertex;
+}
