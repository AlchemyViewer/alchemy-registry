+// sorts data by hash.less, keeping the order of vertices neither is less than; scratch holds count elements
+template <typename Hash>
+static void sortVertices(unsigned int* data, unsigned int* scratch, size_t count, const Hash& hash)
+{
+	unsigned int* source = data;
+	unsigned int* target = scratch;
+
+	for (size_t width = 1; width < count; width *= 2)
+	{
+		for (size_t begin = 0; begin < count; begin += width * 2)
+		{
+			size_t middle = begin + width < count ? begin + width : count;
+			size_t end = begin + width * 2 < count ? begin + width * 2 : count;
+			size_t i = begin, j = middle, k = begin;
+
+			while (i < middle && j < end)
+				target[k++] = hash.less(source[j], source[i]) ? source[j++] : source[i++];
+
+			while (i < middle)
+				target[k++] = source[i++];
+
+			while (j < end)
+				target[k++] = source[j++];
+		}
+
+		unsigned int* swap = source;
+		source = target;
+		target = swap;
+	}
+
+	if (source != data)
+		memcpy(data, source, count * sizeof(unsigned int));
+}
