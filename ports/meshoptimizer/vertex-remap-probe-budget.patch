+// many more probes than vertices means the hash is failing on this input, which can be made to defeat any one hash; the vertices are then sorted
+// instead, which numbers them the same
+template <typename Hash>
+static size_t generateVertexRemapBounded(unsigned int* remap, const unsigned int* indices, size_t index_count, size_t vertex_count, const Hash& hash, meshopt_Allocator& allocator)
+{
+	size_t result = generateVertexRemap(remap, indices, index_count, vertex_count, hash, allocator, vertex_count * 16 + 1024);
+
+	return result != ~size_t(0) ? result : generateVertexRemapSorted(remap, indices, index_count, vertex_count, hash, allocator);
+}
