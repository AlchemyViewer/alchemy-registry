+static void remapCollide()
+{
+	// 4096 vertices of one word, each twice, whose hashes share their low 16 bits, so every lookup starts at the same slot of the table; it probes
+	// past its budget and the vertices are sorted instead, in two more allocations, which must number them as the table does: in the order the
+	// indices first name them, with the vertices no index names left at ~0u
+	const unsigned int count = 4096;
+	const unsigned int m = 0x5bd1e995;
+
+	// m's inverse modulo 2^32
+	unsigned int minv = m;
+	for (int i = 0; i < 5; ++i)
+		minv *= 2 - m * minv;
+
+	std::vector<unsigned int> vb(count * 2);
+
+	for (unsigned int i = 0; i < count; ++i)
+	{
+		// the word that hashes, as k *= m, k ^= k >> 24, k *= m, to i << 16
+		unsigned int k = (i << 16) * minv;
+		k ^= k >> 24;
+		k *= minv;
+
+		vb[i] = k;
+		vb[count * 2 - 1 - i] = k;
+	}
+
+	// every vertex in a scattered order, but for vertex 0, whose copy is named, and both copies of vertex 5
+	std::vector<unsigned int> ib;
+
+	for (unsigned int i = 0; i < count * 2; ++i)
+	{
+		unsigned int v = (i * 2654435761u) % (count * 2);
+
+		if (v != 0 && v != 5 && v != count * 2 - 1 - 5)
+			ib.push_back(v);
+	}
+
+	std::vector<unsigned int> expected(count * 2, ~0u);
+	std::vector<unsigned int> numbers(count, ~0u);
+	unsigned int next = 0;
+
+	for (size_t i = 0; i < ib.size(); ++i)
+	{
+		unsigned int v = ib[i];
+		unsigned int word = v < count ? v : count * 2 - 1 - v;
+
+		if (numbers[word] == ~0u)
+			numbers[word] = next++;
+
+		expected[v] = numbers[word];
+	}
+
+	meshopt_setAllocator(customAlloc, customFree);
+
+	std::vector<unsigned int> remap(count * 2);
+	assert(meshopt_generateVertexRemap(&remap[0], &ib[0], ib.size(), &vb[0], count * 2, sizeof(unsigned int)) == next);
+	assert(remap == expected);
+	assert(allocCount == 3 && freeCount == 3);
+
+	const meshopt_Stream stream = {&vb[0], sizeof(unsigned int), sizeof(unsigned int)};
+
+	remap.assign(count * 2, 0);
+	assert(meshopt_generateVertexRemapMulti(&remap[0], &ib[0], ib.size(), count * 2, &stream, 1) == next);
+	assert(remap == expected);
+	assert(allocCount == 6 && freeCount == 6);
+
+	meshopt_setAllocator(operator new, operator delete);
+
+	allocCount = freeCount = 0;
+}
