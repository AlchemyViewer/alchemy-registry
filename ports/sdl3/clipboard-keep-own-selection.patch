--- a/src/video/wayland/SDL_waylandevents.c
+++ b/src/video/wayland/SDL_waylandevents.c
@@ -2153,10 +2153,16 @@ static void keyboard_handle_leave(void *data, struct wl_keyboard *keyboard,
     }
 
